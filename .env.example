# Sauron config. Copy to .env and fill what you have. The happy path runs
# locally with NONE of the sponsor keys set — stand-ins kick in automatically.
# Fill these in to light up the real sponsor portals in the demo.

# --- The Eye (dashboard) ---
SAURON_PORT=7777

# --- Mount Doom (detonation) ---
SAURON_DETONATE_CALLS=4
CANARY_URL=http://localhost:8808/mcp
CANARY_PORT=8808
CANARY_FLIP_AFTER=3

# --- ClickHouse (real-time analytics backbone) ---
# Local Docker works with the defaults below (docker compose up -d).
# For the demo, show ClickHouse CLOUD: create a service with a NEW email via
# the credits QR, then paste the HTTPS endpoint + password here.
CLICKHOUSE_ENABLED=true
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# Service id from the console URL, for per-run query deep links.
CLICKHOUSE_SERVICE_ID=
CLICKHOUSE_DATABASE=sauron

# --- Semgrep (code security) ---
# Just needs the `semgrep` CLI on PATH. No account for custom rules.
SEMGREP_ENABLED=true
SEMGREP_RULES=semgrep/mcp-rules.yaml

# --- Senso = the Palantir (verified-context verdict store) ---
# docs.senso.ai/sign-up -> API key -> create a folder -> paste its id.
SENSO_API_KEY=
SENSO_FOLDER_ID=
# SENSO_BASE_URL=https://api.senso.ai

# --- Guild = the Black Gate (agent hosting + allowlist/gateway) ---
# guild.ai -> API key + workspace.
GUILD_API_KEY=
# Workspace as <account>~<workspace>, and the Black Gate agent id (SETUP.md).
GUILD_WORKSPACE=
GUILD_AGENT_ID=
# GUILD_BASE_URL=https://api.guild.ai

# --- Akash / AkashML (open-model inference for triage summaries) ---
# akashml.com -> API key. Akash Console deploy credit code: AKASHCYBER25
AKASHML_API_KEY=
# AKASHML_BASE_URL=https://api.akashml.com/v1
# AKASHML_MODEL=gpt-oss-120b

# --- Weather data for the demo MCP server (optional) ---
# The honest get_forecast returns a live forecast via bowmark.ai. Without a key it says "unavailable".
BOWMARK_API_KEY=
